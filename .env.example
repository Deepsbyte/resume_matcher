# Production environment (PostgreSQL)

# Database
DATABASE_URL=postgresql+psycopg2://career:career@postgres:5432/careerdb

# Security / JWT
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173

# OpenAI (optional; app falls back to mock data when empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

